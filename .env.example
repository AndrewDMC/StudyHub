# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose default; change host to your own if not using compose)
DATABASE_URL=postgres://studyhub:studyhub@postgres:5432/studyhub

# Redis (BullMQ)
REDIS_URL=redis://redis:6379

# Filesystem root for subject folders. Mounted from the host in docker-compose
# via STUDYHUB_DATA (see docker/docker-compose.yml); this is the in-container path.
STUDYHUB_DATA_DIR=/data

# Only ever read by apps/worker and apps/cli — never exposed to the browser
# (docs/01-architettura.md §5). Ignored when AI_PROVIDER=claude-cli below.
ANTHROPIC_API_KEY=

# Host-side folder mounted into /data by docker-compose.
STUDYHUB_DATA=./data

# --- Provider AI del worker -------------------------------------------------
# Lascia vuoto per il FakeProvider (default, gratuito, deterministico).
# "claude-cli" instrada le chiamate AI attraverso la CLI `claude`, usando la
# subscription già loggata sulla macchina host invece di ANTHROPIC_API_KEY —
# vedi docker/docker-compose.claude-cli.yml e packages/ai/src/claudeCliProvider.ts.
AI_PROVIDER=

# Solo se AI_PROVIDER=claude-cli, via docker-compose.claude-cli.yml: percorso
# HOST della cartella/file di config di `claude` (`claude login` li ha già
# scritti). Windows: C:\Users\<utente>\.claude e C:\Users\<utente>\.claude.json
# WSL/macOS/Linux: ~/.claude e ~/.claude.json
CLAUDE_CLI_HOME=
CLAUDE_CLI_CONFIG=
