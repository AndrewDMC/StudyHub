# syntax=docker/dockerfile:1
# apps/web (Next.js, standalone output) — multi-stage, non-root, healthcheck.
# Build from the repo root: docker build -f docker/Dockerfile.web -t studyhub/web .
#
# Debian slim, not Alpine: apps/web/src/lib/search.ts calls `@studyhub/ai`'s
# `embedText` (query-side embedding for hybrid search), which loads
# `@xenova/transformers` -> `onnxruntime-node` — a native binding pre-built
# against glibc, no musl build exists upstream. Verified for real: Alpine +
# `libc6-compat` **segfaults** (Ort::Exception, exit 139) the first search
# call; see docker/Dockerfile.worker for the same finding.

FROM node:22-bookworm-slim AS base
RUN corepack enable
WORKDIR /app

# --- prune: reduce the monorepo to what @studyhub/web actually needs -------
FROM base AS pruner
COPY . .
RUN npx turbo prune @studyhub/web --docker

# --- deps: install only the pruned workspace's dependencies ----------------
FROM base AS deps
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile

# --- build -------------------------------------------------------------
FROM base AS build
COPY --from=deps /app/ .
COPY --from=pruner /app/out/full/ .
# `turbo prune --docker` only traces the package.json dependency graph, so it
# drops tsconfig.base.json — a root file every package's tsconfig `extends`,
# outside that graph. Without it: "TS5083: Cannot read file
# '/app/tsconfig.base.json'" (and no per-package compilerOptions at all).
COPY tsconfig.base.json ./tsconfig.base.json
ENV NEXT_TELEMETRY_DISABLED=1
# A DB connection is required to *run* the app, not to build it, but drizzle
# schema imports execute at module-eval time; any syntactically valid URL works.
ENV DATABASE_URL=postgres://build:build@localhost:5432/build
RUN npx turbo run build --filter=@studyhub/web

# --- runtime -------------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

# 1001, not 1000: current node:22 images already ship a `node` user/group at
# gid/uid 1000.
RUN groupadd -g 1001 studyhub && useradd -u 1001 -g studyhub -m -s /bin/sh studyhub

COPY --from=build --chown=studyhub:studyhub /app/apps/web/.next/standalone ./
COPY --from=build --chown=studyhub:studyhub /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=studyhub:studyhub /app/apps/web/public ./apps/web/public

# Claude Code CLI — drives the in-app "Account Claude" sign-in on /admin. The
# login lands in the `claude-auth` volume (docker-compose.yml), shared with the
# worker; nothing is baked into the image and no host files are mounted.
RUN npm install -g @anthropic-ai/claude-code   && mkdir -p /home/studyhub/.claude && chown studyhub:studyhub /home/studyhub/.claude

USER studyhub
ENV HOME=/home/studyhub CLAUDE_CONFIG_DIR=/home/studyhub/.claude
EXPOSE 3000
ENV PORT=3000 HOSTNAME=0.0.0.0

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/web/server.js"]
