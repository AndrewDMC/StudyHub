# syntax=docker/dockerfile:1
# apps/worker + apps/cli (same code, "invocato one-shot" per
# docs/01-architettura.md §1) — multi-stage, non-root, healthcheck.
# Build from the repo root: docker build -f docker/Dockerfile.worker -t studyhub/worker .
#
# Debian slim, not Alpine: `@xenova/transformers` (packages/ai/src/embeddings.ts)
# ships `onnxruntime-node`'s native binding pre-built against glibc — no musl
# build exists upstream. Verified for real: even Alpine + `libc6-compat`
# **segfaults** (Ort::Exception, exit 139) the first time a model loads; the
# shim covers simple symbol lookups, not a native addon this size. Every other
# dependency here (`@napi-rs/canvas`, `sharp`, `pg`) supports glibc too, so
# there's no corresponding tradeoff the other way.

FROM node:22-bookworm-slim AS base
RUN corepack enable
WORKDIR /app

# --- prune -------------------------------------------------------------
FROM base AS pruner
COPY . .
RUN npx turbo prune @studyhub/worker @studyhub/cli --docker

# --- deps ----------------------------------------------------------------
FROM base AS deps
COPY --from=pruner /app/out/json/ .
RUN pnpm install --frozen-lockfile

# --- build -----------------------------------------------------------------
FROM base AS build
COPY --from=deps /app/ .
COPY --from=pruner /app/out/full/ .
# `turbo prune --docker` only traces the package.json dependency graph, so it
# drops tsconfig.base.json — a root file every package's tsconfig `extends`,
# outside that graph. Without it: "TS5083: Cannot read file
# '/app/tsconfig.base.json'" (and no per-package compilerOptions at all).
COPY tsconfig.base.json ./tsconfig.base.json
RUN npx turbo run build --filter=@studyhub/worker --filter=@studyhub/cli
# Drop dev dependencies (tsx, vitest, typescript, ...) before shipping.
# --ignore-scripts: the root package.json's own `prepare` (husky) has nothing
# to hook into here (no .git, and husky itself was just dropped as a dev
# dependency) — it only exists for local `pnpm install`.
RUN pnpm install --frozen-lockfile --prod --ignore-scripts

# --- runtime -----------------------------------------------------------
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production

# 1001, not 1000: current node:22 images already ship a `node` user/group at
# gid/uid 1000.
RUN groupadd -g 1001 studyhub && useradd -u 1001 -g studyhub -m -s /bin/sh studyhub

COPY --from=build --chown=studyhub:studyhub /app .

# Every internal package (@studyhub/db, @studyhub/core, ...) resolves via its
# package.json "main"/"exports" straight to its TypeScript *source*
# (./src/index.ts — deliberately, so `pnpm dev` needs no build step). Plain
# `node apps/worker/dist/index.js` therefore still ends up importing
# `packages/db/src/index.ts` at runtime — and plain Node doesn't resolve that
# file's own `./schema.js` relative imports against the sibling `schema.ts`
# (ERR_MODULE_NOT_FOUND). `tsx` is what makes that resolution work — it's
# exactly what `pnpm dev` already runs on this same source, so this is the
# same code path as local dev, not a separate one. The `tsc` build above is
# kept as a type-correctness gate (the image fails to build on a type error);
# it isn't what actually runs here.
RUN npm install -g tsx

# `studyhub` on PATH -> apps/cli/src/index.ts (docs/01-architettura.md: cli
# is the worker's own code invoked one-shot).
RUN printf '#!/bin/sh\nexec tsx /app/apps/cli/src/index.ts "$@"\n' > /usr/local/bin/studyhub \
  && chmod +x /usr/local/bin/studyhub

# Claude Code CLI — used by ClaudeCliProvider (packages/ai/src/claudeCliProvider.ts)
# once the user signs in from /admin. The login lives in the `claude-auth` volume
# (docker-compose.yml), written by the web container and read here — nothing is
# baked into the image and no host files are mounted.
RUN npm install -g @anthropic-ai/claude-code   && mkdir -p /home/studyhub/.claude && chown studyhub:studyhub /home/studyhub/.claude

USER studyhub
ENV HOME=/home/studyhub CLAUDE_CONFIG_DIR=/home/studyhub/.claude
ENV STUDYHUB_DATA_DIR=/data

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
  CMD node -e "const fs=require('fs');try{const t=parseInt(fs.readFileSync('/tmp/studyhub-worker-heartbeat','utf8'),10);process.exit(Date.now()-t<60000?0:1)}catch(e){process.exit(1)}"

CMD ["tsx", "apps/worker/src/index.ts"]
